          Value: false
        rf_foot_link:
          Value: false
        rf_hip_link:
          Value: false
        rf_lower_leg_link:
          Value: false
        rf_upper_leg_link:
          Value: false
        rh_foot_link:
          Value: false
        rh_hip_link:
          Value: false
        rh_lower_leg_link:
          Value: false
        rh_upper_leg_link:
          Value: false
        trunk:
          Value: false
        velodyne:
          Value: false
        velodyne_base_link:
          Value: false
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          base_link:
            trunk:
              gps_link:
                {}
              lf_hip_link:
                lf_upper_leg_link:
                  lf_lower_leg_link:
                    lf_foot_link:
                      {}
              lh_hip_link:
                lh_upper_leg_link:
                  lh_lower_leg_link:
                    lh_foot_link:
                      {}
              livox:
                livox_imu:
                  {}
              rf_hip_link:
